/-
Feed.EmitBody — M5: request-body JSON parsing + POST /posts + POST /posts/:id/like,
all emitted as asm. Mirrors Model.createPost / Model.likePost + Contract bodies.

New asm routines (strict, mirroring Feed.Json.parse / Feed.Types.trim):
  json_valid_asm(rdi, rsi) -> al  — strict recursive-descent JSON grammar check
      (ws = " \t\n\r"; strings: no raw C0, escapes " \ / b f n r t uXXXX with
       surrogate pairs required; numbers: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?;
       literals true/false/null; depth cap 64; trailing garbage rejected)
  json_unescape_asm(rdi=dst, rsi=cap, rdx=src, rcx=len) -> rax len | -1
      (src = span BETWEEN quotes)
  trim_asm(rdi=ptr, rsi=len) -> rax ptr, r8 len    — ws = space/tab/nl/cr
  cplen_asm(rdi=ptr, rsi=len) -> rax               — UTF-8 code point count

This module owns `program` (the final .s file).
-/

import Feed.EmitAsm
import Feed.EmitAuth

open EmitAsm EmitAuth

namespace EmitBody

/-! ## tiny emit helpers -/

/-- Inline skip-ws advancing r13 (r14 = end). Clobbers eax. Tag = unique suffix. -/
def skipWs (a : Asm) (tag : String) : Asm :=
  a.label s!"jv_ws_i_{tag}"
   |>.insn "cmp r13, r14"
   |>.insn s!"jae jv_ws_d_{tag}"
   |>.insn "movzx eax, BYTE PTR [r13]"
   |>.insn "cmp al, 32"
   |>.insn s!"je jv_ws_a_{tag}"
   |>.insn "cmp al, 9"
   |>.insn s!"je jv_ws_a_{tag}"
   |>.insn "cmp al, 10"
   |>.insn s!"je jv_ws_a_{tag}"
   |>.insn "cmp al, 13"
   |>.insn s!"jne jv_ws_d_{tag}"
   |>.label s!"jv_ws_a_{tag}"
   |>.insn "inc r13"
   |>.insn s!"jmp jv_ws_i_{tag}"
   |>.label s!"jv_ws_d_{tag}"

/-- fail path: clear the global ok flag and jump to the common exit. -/
def failTo (a : Asm) (exit : String) : Asm :=
  a.insn "mov QWORD PTR [rip+jv_ok], 0"
   |>.insn (s!"jmp {exit}")

/-! ## json_valid_asm -/

def emitJsonValid (a : Asm) : Asm :=
  let a := a.raw ".globl json_valid_asm"
  let a := a.label "json_valid_asm"
  let a := a.insn "push r13"
  let a := a.insn "push r14"
  let a := a.insn "push r15"
  let a := a.insn "mov r13, rdi"
  let a := a.insn "lea r14, [rdi+rsi]"
  let a := a.insn "mov QWORD PTR [rip+jv_ok], 1"
  let a := a.insn "xor r15d, r15d"
  let a := a.insn "push rdi"
  let a := a.insn "push rsi"
  let a := a.insn "push rdi"
  let a := a.insn "push rsi"
  let a := a.insn "sub rsp, 8"
  let a := a.insn "call utf8ok_asm"
  let a := a.insn "add rsp, 8"
  let a := a.insn "pop rsi"
  let a := a.insn "pop rdi"
  let a := a.insn "pop rsi"
  let a := a.insn "pop rdi"
  let a := a.insn "test al, al"
  let a := a.insn "jz jv_ret0"
  let a := a.insn "mov r13, rdi"
  let a := a.insn "lea r14, [rdi+rsi]"
  let a := a.insn "call jv_value"
  let a := skipWs a "t1"
  let a := a.insn "mov rax, [rip+jv_ok]"
  let a := a.insn "test rax, rax"
  let a := a.insn "jz jv_ret0"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jne jv_ret0"
  let a := a.insn "mov al, 1"
  let a := a.insn "jmp jv_out"
  let a := a.label "jv_ret0"
  let a := a.insn "xor eax, eax"
  let a := a.label "jv_out"
  let a := a.insn "pop r15"
  let a := a.insn "pop r14"
  let a := a.insn "pop r13"
  let a := a.insn "ret"
  -- hexval: al char -> al value (0..15) or 0xFF
  let a := a.label "jv_hexval"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_hexval_no"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_hexval_alpha"
  let a := a.insn "sub al, 48"
  let a := a.insn "ret"
  let a := a.label "jv_hexval_alpha"
  let a := a.insn "or al, 32"
  let a := a.insn "cmp al, 97"
  let a := a.insn "jb jv_hexval_no"
  let a := a.insn "cmp al, 102"
  let a := a.insn "ja jv_hexval_no"
  let a := a.insn "sub al, 87"
  let a := a.insn "ret"
  let a := a.label "jv_hexval_no"
  let a := a.insn "mov al, 255"
  let a := a.insn "ret"
  a

/-- Parse 4 hex digits at [r13+1+rcx] into edx; leaves rcx=4; fail -> jv_bad.
    Helper SUBROUTINE (no calls). Entry: r13 at 'u'. -/
def emitJsonValidU4 (a : Asm) : Asm :=
  let a := a.label "jv_parse_u4"
  let a := a.insn "lea rax, [r13+4]"
  let a := a.insn "cmp rax, r14"
  let a := a.insn "ja jv_parse_u4_bad"
  let a := a.insn "xor edx, edx"
  let a := a.insn "xor ecx, ecx"
  let a := a.label "jv_parse_u4_loop"
  let a := a.insn "movzx eax, BYTE PTR [r13+1+rcx]"
  let a := a.insn "call jv_hexval"
  let a := a.insn "cmp al, 255"
  let a := a.insn "je jv_parse_u4_bad"
  let a := a.insn "shl edx, 4"
  let a := a.insn "or edx, eax"
  let a := a.insn "inc ecx"
  let a := a.insn "cmp ecx, 4"
  let a := a.insn "jb jv_parse_u4_loop"
  let a := a.insn "ret"
  let a := a.label "jv_parse_u4_bad"
  let a := a.insn "mov QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "ret"
  a

/-- Strict string scanner: r13 AT opening quote; leaves r13 AFTER closing quote. -/
def emitJsonValidString (a : Asm) : Asm :=
  let a := a.label "jv_string"
  let a := a.insn "inc r13"
  let a := a.label "jv_str_loop"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_str_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 32"
  let a := a.insn "jb jv_str_bad"
  let a := a.insn "cmp al, 34"
  let a := a.insn "je jv_str_end"
  let a := a.insn "cmp al, 92"
  let a := a.insn "je jv_str_esc"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_str_loop"
  let a := a.label "jv_str_end"
  let a := a.insn "inc r13"
  let a := a.insn "ret"
  -- escape handling
  let a := a.label "jv_str_esc"
  let a := a.insn "inc r13"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_str_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 34"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 92"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 47"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 98"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 102"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 110"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 114"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 116"
  let a := a.insn "je jv_str_esc_ok"
  let a := a.insn "cmp al, 117"
  let a := a.insn "je jv_str_esc_u"
  let a := failTo a "jv_str_bad"
  let a := a.label "jv_str_esc_ok"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_str_loop"
  -- \uXXXX (+ mandatory pairing for high surrogates)
  let a := a.label "jv_str_esc_u"
  let a := a.insn "call jv_parse_u4"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_str_bad"
  let a := a.insn "cmp edx, 0xD800"
  let a := a.insn "jb jv_str_u_done"
  let a := a.insn "cmp edx, 0xDBFF"
  let a := a.insn "ja jv_str_bad"            -- lone low surrogate
  -- high: require "\u" + low surrogate
  let a := a.insn "add r13, 5"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_str_bad"
  let a := a.insn "cmp BYTE PTR [r13], 92"
  let a := a.insn "jne jv_str_bad"
  let a := a.insn "inc r13"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_str_bad"
  let a := a.insn "cmp BYTE PTR [r13], 117"
  let a := a.insn "jne jv_str_bad"
  let a := a.insn "call jv_parse_u4"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_str_bad"
  let a := a.insn "cmp edx, 0xDC00"
  let a := a.insn "jb jv_str_bad"
  let a := a.insn "cmp edx, 0xDFFF"
  let a := a.insn "ja jv_str_bad"
  let a := a.insn "add r13, 5"
  let a := a.insn "jmp jv_str_loop"
  let a := a.label "jv_str_u_done"
  let a := a.insn "add r13, 5"
  let a := a.insn "jmp jv_str_loop"
  let a := a.label "jv_str_bad"
  let a := a.insn "mov QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "ret"
  a

/-- Number scanner: r13 at first byte; leaves r13 past the number. -/
def emitJsonValidNumber (a : Asm) : Asm :=
  let a := a.label "jv_number"
  let a := a.insn "cmp BYTE PTR [r13], 45"
  let a := a.insn "jne jv_num_int"
  let a := a.insn "inc r13"
  let a := a.label "jv_num_int"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_bad"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_bad"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jne jv_num_digits"
  -- single 0, next must not be a digit (no leading zeros)
  let a := a.insn "inc r13"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_frac"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_frac"
  let a := a.insn "cmp al, 57"
  let a := a.insn "jbe jv_num_bad"
  let a := a.insn "jmp jv_num_frac"
  let a := a.label "jv_num_digits"
  let a := a.label "jv_num_digits_loop"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_frac"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_frac"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_frac"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_num_digits_loop"
  -- optional fraction
  let a := a.label "jv_num_frac"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_ret"
  let a := a.insn "cmp BYTE PTR [r13], 46"
  let a := a.insn "jne jv_num_exp"
  let a := a.insn "inc r13"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_bad"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_bad"
  let a := a.label "jv_num_frac_loop"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_exp"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_exp"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_exp"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_num_frac_loop"
  -- optional exponent
  let a := a.label "jv_num_exp"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_ret"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 101"
  let a := a.insn "je jv_num_exp_go"
  let a := a.insn "cmp al, 69"
  let a := a.insn "jne jv_num_ret"
  let a := a.label "jv_num_exp_go"
  let a := a.insn "inc r13"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 43"
  let a := a.insn "je jv_num_exp_sign"
  let a := a.insn "cmp al, 45"
  let a := a.insn "jne jv_num_exp_dig"
  let a := a.label "jv_num_exp_sign"
  let a := a.insn "inc r13"
  let a := a.label "jv_num_exp_dig"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_bad"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_bad"
  let a := a.label "jv_num_exp_loop"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_num_ret"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb jv_num_ret"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja jv_num_ret"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_num_exp_loop"
  let a := a.label "jv_num_ret"
  let a := a.insn "ret"
  let a := a.label "jv_num_bad"
  let a := a.insn "mov QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "ret"
  a

/-- The recursive value parser (r15 = depth; r13 cursor; r14 end; jv_ok flag). -/
def emitJsonValidValue (a : Asm) : Asm :=
  let a := a.label "jv_value"
  let a := a.insn "push r15"
  let a := a.insn "cmp r15, 64"
  let a := a.insn "ja jv_bad"
  let a := skipWs a "t2"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "movzx eax, BYTE PTR [r13]"
  let a := a.insn "cmp al, 123"
  let a := a.insn "je jv_obj"
  let a := a.insn "cmp al, 91"
  let a := a.insn "je jv_arr"
  let a := a.insn "cmp al, 34"
  let a := a.insn "je jv_val_str"
  let a := a.insn "cmp al, 116"
  let a := a.insn "je jv_true"
  let a := a.insn "cmp al, 102"
  let a := a.insn "je jv_false"
  let a := a.insn "cmp al, 110"
  let a := a.insn "je jv_null"
  let a := a.insn "call jv_number"
  let a := a.insn "jmp jv_val_done"
  -- string value
  let a := a.label "jv_val_str"
  let a := a.insn "call jv_string"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_bad"
  let a := a.insn "jmp jv_val_done"
  -- true / false / null
  let a := a.label "jv_true"
  let a := a.insn "lea rax, [r13+3]"
  let a := a.insn "cmp rax, r14"
  let a := a.insn "ja jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+1], 114"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+2], 117"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+3], 101"
  let a := a.insn "jne jv_bad"
  let a := a.insn "add r13, 4"
  let a := a.insn "jmp jv_val_done"
  let a := a.label "jv_false"
  let a := a.insn "lea rax, [r13+4]"
  let a := a.insn "cmp rax, r14"
  let a := a.insn "ja jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+1], 97"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+2], 108"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+3], 115"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+4], 101"
  let a := a.insn "jne jv_bad"
  let a := a.insn "add r13, 5"
  let a := a.insn "jmp jv_val_done"
  let a := a.label "jv_null"
  let a := a.insn "lea rax, [r13+3]"
  let a := a.insn "cmp rax, r14"
  let a := a.insn "ja jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+1], 117"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+2], 108"
  let a := a.insn "jne jv_bad"
  let a := a.insn "cmp BYTE PTR [r13+3], 108"
  let a := a.insn "jne jv_bad"
  let a := a.insn "add r13, 4"
  let a := a.insn "jmp jv_val_done"
  -- object
  let a := a.label "jv_obj"
  let a := a.insn "inc r13"
  let a := skipWs a "t3"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 125"
  let a := a.insn "je jv_obj_empty"
  let a := a.label "jv_obj_pair"
  let a := a.insn "cmp BYTE PTR [r13], 34"
  let a := a.insn "jne jv_bad"
  let a := a.insn "call jv_string"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_bad"
  let a := skipWs a "t4"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 58"
  let a := a.insn "jne jv_bad"
  let a := a.insn "inc r13"
  let a := a.insn "inc r15"
  let a := a.insn "call jv_value"
  let a := a.insn "dec r15"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_bad"
  let a := skipWs a "t5"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 44"
  let a := a.insn "je jv_obj_comma"
  let a := a.insn "cmp BYTE PTR [r13], 125"
  let a := a.insn "je jv_obj_close"
  let a := failTo a "jv_bad"
  let a := a.label "jv_obj_comma"
  let a := a.insn "inc r13"
  let a := skipWs a "t6"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "jmp jv_obj_pair"   -- trailing comma rejected by the '"' test
  let a := a.label "jv_obj_close"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_val_done"
  let a := a.label "jv_obj_empty"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_val_done"
  -- array
  let a := a.label "jv_arr"
  let a := a.insn "inc r13"
  let a := skipWs a "t7"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 93"
  let a := a.insn "je jv_arr_empty"
  let a := a.label "jv_arr_item"
  let a := a.insn "inc r15"
  let a := a.insn "call jv_value"
  let a := a.insn "dec r15"
  let a := a.insn "cmp QWORD PTR [rip+jv_ok], 0"
  let a := a.insn "je jv_bad"
  let a := skipWs a "t8"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 44"
  let a := a.insn "je jv_arr_comma"
  let a := a.insn "cmp BYTE PTR [r13], 93"
  let a := a.insn "je jv_arr_close"
  let a := failTo a "jv_bad"
  let a := a.label "jv_arr_comma"
  let a := a.insn "inc r13"
  let a := skipWs a "t9"
  let a := a.insn "cmp r13, r14"
  let a := a.insn "jae jv_bad"
  let a := a.insn "cmp BYTE PTR [r13], 93"
  let a := a.insn "je jv_bad"          -- trailing comma
  let a := a.insn "jmp jv_arr_item"
  let a := a.label "jv_arr_close"
  let a := a.insn "inc r13"
  let a := a.insn "jmp jv_val_done"
  let a := a.label "jv_arr_empty"
  let a := a.insn "inc r13"
  let a := a.label "jv_val_done"
  let a := a.insn "pop r15"
  let a := a.insn "ret"
  let a := a.label "jv_bad"
  let a := a.insn "mov QWORD PTR [rip+jv_ok], 0"
  let a := a.label "jv_exit"
  let a := a.insn "pop r15"
  let a := a.insn "ret"
  a

/-! ## json_unescape_asm: decode a JSON string span (between quotes) to bytes -/

def emitJsonUnescape (a : Asm) : Asm :=
  let a := a.raw ".globl json_unescape_asm"
  let a := a.label "json_unescape_asm"        -- (rdi=dst, rsi=cap, rdx=src, rcx=len) -> rax
  let a := a.insn "push rbx"
  let a := a.insn "push r12"
  let a := a.insn "mov r8, rdi"               -- dst cursor
  let a := a.insn "lea r9, [rdi+rsi]"         -- dst end
  let a := a.insn "mov r10, rdx"              -- src cursor
  let a := a.insn "lea r11, [rdx+rcx]"        -- src end
  let a := a.label "ju_loop"
  let a := a.insn "cmp r10, r11"
  let a := a.insn "jae ju_done"
  let a := a.insn "movzx eax, BYTE PTR [r10]"
  let a := a.insn "cmp al, 92"
  let a := a.insn "je ju_esc"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov [r8], al"
  let a := a.insn "inc r8"
  let a := a.insn "inc r10"
  let a := a.insn "jmp ju_loop"
  -- escapes
  let a := a.label "ju_esc"
  let a := a.insn "inc r10"
  let a := a.insn "cmp r10, r11"
  let a := a.insn "jae ju_bad"
  let a := a.insn "movzx eax, BYTE PTR [r10]"
  let a := a.insn "cmp al, 34"
  let a := a.insn "je ju_lit"
  let a := a.insn "cmp al, 92"
  let a := a.insn "je ju_lit"
  let a := a.insn "cmp al, 47"
  let a := a.insn "je ju_lit"
  let a := a.insn "cmp al, 98"
  let a := a.insn "je ju_bs"
  let a := a.insn "cmp al, 102"
  let a := a.insn "je ju_ff"
  let a := a.insn "cmp al, 110"
  let a := a.insn "je ju_nl"
  let a := a.insn "cmp al, 114"
  let a := a.insn "je ju_cr"
  let a := a.insn "cmp al, 116"
  let a := a.insn "je ju_tab"
  let a := a.insn "cmp al, 117"
  let a := a.insn "je ju_uni"
  let a := a.insn "jmp ju_bad"
  let a := a.label "ju_lit"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov [r8], al"
  let a := a.insn "inc r8"
  let a := a.insn "inc r10"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_bs"
  let a := a.insn "inc r10"
  let a := a.insn "jmp ju_put8"
  let a := a.label "ju_put8"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov BYTE PTR [r8], 8"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_ff"
  let a := a.insn "inc r10"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov BYTE PTR [r8], 12"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_nl"
  let a := a.insn "inc r10"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov BYTE PTR [r8], 10"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_cr"
  let a := a.insn "inc r10"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov BYTE PTR [r8], 13"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_tab"
  let a := a.insn "inc r10"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov BYTE PTR [r8], 9"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  -- \uXXXX (+ surrogate pairs) -> UTF-8
  let a := a.label "ju_uni"
  let a := a.insn "lea rax, [r10+4]"
  let a := a.insn "cmp rax, r11"
  let a := a.insn "ja ju_bad"
  let a := a.insn "xor edx, edx"              -- collects the code point
  let a := a.insn "mov ecx, 4"
  let a := a.label "ju_uni_loop"
  let a := a.insn "movzx eax, BYTE PTR [r10+1]"
  let a := a.insn "call ju_hexval"
  let a := a.insn "cmp al, 255"
  let a := a.insn "je ju_bad"
  let a := a.insn "shl edx, 4"
  let a := a.insn "or edx, eax"
  let a := a.insn "inc r10"
  let a := a.insn "dec ecx"
  let a := a.insn "jnz ju_uni_loop"
  let a := a.insn "inc r10"                   -- past last hex
  -- high surrogate? pair with a following \uXXXX
  let a := a.insn "cmp edx, 0xD800"
  let a := a.insn "jb ju_uni_emit"
  let a := a.insn "cmp edx, 0xDBFF"
  let a := a.insn "ja ju_chk_low"             -- not a high surrogate
  let a := a.insn "sub edx, 0xD800"
  let a := a.insn "shl edx, 10"               -- hi bits
  let a := a.insn "mov ebx, edx"              -- hmm: keep in r12d (callee-saved not pushed) -> use [rsp]? use r12d and save
  let a := a.label "ju_uni_second"
  let a := a.insn "lea rax, [r10+6]"
  let a := a.insn "cmp rax, r11"
  let a := a.insn "ja ju_bad"
  let a := a.insn "cmp BYTE PTR [r10], 92"
  let a := a.insn "jne ju_bad"
  let a := a.insn "cmp BYTE PTR [r10+1], 117"
  let a := a.insn "jne ju_bad"
  let a := a.insn "mov ecx, 4"
  let a := a.insn "xor edx, edx"
  let a := a.label "ju_uni_loop2"
  let a := a.insn "movzx eax, BYTE PTR [r10+2]"
  let a := a.insn "call ju_hexval"
  let a := a.insn "cmp al, 255"
  let a := a.insn "je ju_bad"
  let a := a.insn "shl edx, 4"
  let a := a.insn "or edx, eax"
  let a := a.insn "inc r10"
  let a := a.insn "dec ecx"
  let a := a.insn "jnz ju_uni_loop2"
  let a := a.insn "add r10, 2"
  let a := a.insn "cmp edx, 0xDC00"
  let a := a.insn "jb ju_bad"
  let a := a.insn "cmp edx, 0xDFFF"
  let a := a.insn "ja ju_bad"
  let a := a.insn "sub edx, 0xDC00"
  let a := a.insn "mov r12d, edx"
  let a := a.insn "or r12d, ebx"              -- 20-bit pair value
  let a := a.insn "add r12d, 0x10000"         -- edx = full code point
  let a := a.insn "mov edx, r12d"
  let a := a.insn "jmp ju_uni_emit"
  let a := a.label "ju_chk_low"
  let a := a.insn "cmp edx, 0xDFFF"
  let a := a.insn "jbe ju_bad"                -- lone low surrogate
  let a := a.label "ju_uni_emit"
  -- UTF-8 encode edx into [r8]
  let a := a.insn "cmp edx, 0x80"
  let a := a.insn "jb ju_u1"
  let a := a.insn "cmp edx, 0x800"
  let a := a.insn "jb ju_u2"
  let a := a.insn "cmp edx, 0x10000"
  let a := a.insn "jb ju_u3"
  -- 4 bytes
  let a := a.insn "lea rax, [r8+4]"
  let a := a.insn "cmp rax, r9"
  let a := a.insn "ja ju_full"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 18"
  let a := a.insn "or eax, 0xF0"
  let a := a.insn "mov [r8], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 12"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+1], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 6"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+2], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+3], al"
  let a := a.insn "add r8, 4"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_u3"
  let a := a.insn "lea rax, [r8+3]"
  let a := a.insn "cmp rax, r9"
  let a := a.insn "ja ju_full"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 12"
  let a := a.insn "or eax, 0xE0"
  let a := a.insn "mov [r8], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 6"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+1], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+2], al"
  let a := a.insn "add r8, 3"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_u2"
  let a := a.insn "lea rax, [r8+2]"
  let a := a.insn "cmp rax, r9"
  let a := a.insn "ja ju_full"
  let a := a.insn "mov eax, edx"
  let a := a.insn "shr eax, 6"
  let a := a.insn "or eax, 0xC0"
  let a := a.insn "mov [r8], al"
  let a := a.insn "mov eax, edx"
  let a := a.insn "and eax, 63"
  let a := a.insn "or eax, 0x80"
  let a := a.insn "mov [r8+1], al"
  let a := a.insn "add r8, 2"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_u1"
  let a := a.insn "cmp r8, r9"
  let a := a.insn "jae ju_full"
  let a := a.insn "mov [r8], dl"
  let a := a.insn "inc r8"
  let a := a.insn "jmp ju_loop"
  let a := a.label "ju_done"
  let a := a.insn "mov rax, r8"
  let a := a.insn "sub rax, rdi"
  let a := a.insn "pop r12"
  let a := a.insn "pop rbx"
  let a := a.insn "ret"
  let a := a.label "ju_bad"
  let a := a.insn "mov rax, -1"
  let a := a.insn "pop r12"
  let a := a.insn "pop rbx"
  let a := a.insn "ret"
  let a := a.label "ju_full"
  let a := a.insn "mov rax, -2"
  let a := a.insn "pop r12"
  let a := a.insn "pop rbx"
  let a := a.insn "ret"
  -- hexval shared with the validator (reuse jv_hexval)
  let a := a.label "ju_hexval"
  let a := a.insn "cmp al, 48"
  let a := a.insn "jb ju_hexval_no"
  let a := a.insn "cmp al, 57"
  let a := a.insn "ja ju_hexval_alpha"
  let a := a.insn "sub al, 48"
  let a := a.insn "ret"
  let a := a.label "ju_hexval_alpha"
  let a := a.insn "or al, 32"
  let a := a.insn "cmp al, 97"
  let a := a.insn "jb ju_hexval_no"
  let a := a.insn "cmp al, 102"
  let a := a.insn "ja ju_hexval_no"
  let a := a.insn "sub al, 87"
  let a := a.insn "ret"
  let a := a.label "ju_hexval_no"
  let a := a.insn "mov al, 255"
  let a := a.insn "ret"
  a

/-! ## trim + code-point count -/

def emitTrim (a : Asm) : Asm :=
  let a := a.raw ".globl trim_asm"
  let a := a.label "trim_asm"                 -- (rdi=ptr, rsi=len) -> rax ptr, r8 len
  let a := a.insn "mov rax, rdi"
  let a := a.insn "mov r8, rsi"
  let a := a.label "tr_lead"
  let a := a.insn "test r8, r8"
  let a := a.insn "jz tr_done"
  let a := a.insn "movzx ecx, BYTE PTR [rax]"
  let a := a.insn "cmp cl, 32"
  let a := a.insn "je tr_adv"
  let a := a.insn "cmp cl, 9"
  let a := a.insn "je tr_adv"
  let a := a.insn "cmp cl, 10"
  let a := a.insn "je tr_adv"
  let a := a.insn "cmp cl, 13"
  let a := a.insn "je tr_adv"
  let a := a.insn "jmp tr_tail"
  let a := a.label "tr_adv"
  let a := a.insn "inc rax"
  let a := a.insn "dec r8"
  let a := a.insn "jmp tr_lead"
  let a := a.label "tr_tail"
  let a := a.insn "test r8, r8"
  let a := a.insn "jz tr_done"
  let a := a.insn "movzx ecx, BYTE PTR [rax+r8-1]"
  let a := a.insn "cmp cl, 32"
  let a := a.insn "je tr_tadv"
  let a := a.insn "cmp cl, 9"
  let a := a.insn "je tr_tadv"
  let a := a.insn "cmp cl, 10"
  let a := a.insn "je tr_tadv"
  let a := a.insn "cmp cl, 13"
  let a := a.insn "je tr_tadv"
  let a := a.insn "jmp tr_done"
  let a := a.label "tr_tadv"
  let a := a.insn "dec r8"
  let a := a.insn "jmp tr_tail"
  let a := a.label "tr_done"
  let a := a.insn "ret"
  a

def emitCpLen (a : Asm) : Asm :=
  let a := a.raw ".globl cplen_asm"
  let a := a.label "cplen_asm"                -- (rdi=ptr, rsi=len) -> rax count
  let a := a.insn "xor eax, eax"
  let a := a.insn "xor rcx, rcx"
  let a := a.label "cp_loop"
  let a := a.insn "cmp rcx, rsi"
  let a := a.insn "jae cp_done"
  let a := a.insn "movzx edx, BYTE PTR [rdi+rcx]"
  let a := a.insn "and edx, 0xC0"
  let a := a.insn "cmp edx, 0x80"
  let a := a.insn "je cp_cont"
  let a := a.insn "inc rax"
  let a := a.label "cp_cont"
  let a := a.insn "inc rcx"
  let a := a.insn "jmp cp_loop"
  let a := a.label "cp_done"
  let a := a.insn "ret"
  a

/-! ## POST /posts (create) and POST /posts/:id/like (final handlers) -/

/-- POST /posts after auth OK: validate body, INSERT ... RETURNING, serialize. -/
def emitCreatePost (a : Asm) : Asm :=
  let a := a.label ".Lcreate_body"
  -- frame: body[0,0x5000) created_at[0x5000,0x5020) tidy ptr[0x5020] len[0x5028] ca_len[0x5030]
  let a := a.insn "sub rsp, 0x5040"
  let a := a.insn "mov rdi, [rbx+APPREQ_BODY]"
  let a := a.insn "movsx rsi, DWORD PTR [rbx+APPREQ_BODY_LEN]"
  let a := a.insn "test rsi, rsi"
  let a := a.insn "jz .Lcreate_malformed"
  let a := a.insn "cmp rsi, 16000"
  let a := a.insn "ja .Lcreate_malformed"     -- beyond sane body: out of scope; treat malformed
  let a := a.insn "call json_valid_asm"
  let a := a.insn "test al, al"
  let a := a.insn "jz .Lcreate_malformed"
  let a := a.insn "mov rdi, [rbx+APPREQ_BODY]"
  let a := a.insn "movsx rsi, DWORD PTR [rbx+APPREQ_BODY_LEN]"
  let (a, lKey) := a.poolStr "body"
  let a := a.insn (s!"lea rdx, [rip+{lKey}]")
  let a := a.insn "mov ecx, 4"
  let a := a.insn "call jsonfind_asm"
  let a := a.insn "test rax, rax"
  let a := a.insn "jz .Lcreate_required"
  let a := a.insn "cmp r8, 2"
  let a := a.insn "jb .Lcreate_required"
  let a := a.insn "cmp BYTE PTR [rax], 34"
  let a := a.insn "jne .Lcreate_required"
  let a := a.insn "cmp BYTE PTR [rax+r8-1], 34"
  let a := a.insn "jne .Lcreate_required"
  let a := a.insn "lea rdx, [rax+1]"
  let a := a.insn "mov rcx, r8"
  let a := a.insn "sub rcx, 2"
  let a := a.insn "lea rdi, [rsp]"
  let a := a.insn "mov esi, 20480"
  let a := a.insn "call json_unescape_asm"
  let a := a.insn "cmp rax, 0"
  let a := a.insn "jl .Lcreate_500x"
  let a := a.insn "mov r14, rax"
  let a := a.insn "lea rdi, [rsp]"
  let a := a.insn "mov rsi, r14"
  let a := a.insn "call trim_asm"
  let a := a.insn "mov [rsp+0x5020], rax"
  let a := a.insn "mov [rsp+0x5028], r8"
  let a := a.insn "test r8, r8"
  let a := a.insn "jz .Lcreate_required"
  let a := a.insn "mov rdi, rax"
  let a := a.insn "mov rsi, r8"
  let a := a.insn "call cplen_asm"
  let a := a.insn "cmp rax, 500"
  let a := a.insn "ja .Lcreate_toolong"
  -- INSERT ... RETURNING
  let sql := "INSERT INTO posts (user_id, body) VALUES (?, ?) RETURNING id, created_at"
  let (a, lSql) := a.poolStr sql
  let a := a.insn (s!"lea rdi, [rip+{lSql}]")
  let a := a.insn (s!"mov esi, {String.length sql}")
  let a := a.call "x_db_prepare"
  let a := a.insn "test rax, rax"
  let a := a.insn "jz .Lcreate_500x"
  let a := a.insn "mov r13, rax"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 1"
  let a := a.insn "mov rdx, [rip+g_uid]"
  let a := a.call "x_db_bind_int"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 2"
  let a := a.insn "mov rdx, [rsp+0x5020]"
  let a := a.insn "mov rcx, [rsp+0x5028]"
  let a := a.call "x_db_bind_text"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_step"
  let a := a.insn "cmp eax, 1"
  let a := a.insn "jne .Lcreate_500x"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "xor esi, esi"
  let a := a.call "x_db_column_int"
  let a := a.insn "mov r14, rax"               -- new id
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 1"
  let a := a.call "x_db_column_text"
  let a := a.insn "mov r15, rax"               -- created_at ptr
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 1"
  let a := a.call "x_db_column_bytes"
  let a := a.insn "mov [rsp+0x5030], rax"
  -- serialize
  let a := outStr a "r12" "{\"post\":{\"id\":"
  let a := a.insn "mov rdi, r12"
  let a := a.insn "mov rsi, r14"
  let a := a.call "x_out_int"
  let a := outStr a "r12" ",\"body\":\""
  let a := a.insn "mov rsi, [rsp+0x5020]"
  let a := a.insn "mov rdx, [rsp+0x5028]"
  let a := a.insn "mov rdi, r12"
  let a := a.call "x_out_json_escaped_str"
  let a := outStr a "r12" "\",\"created_at\":\""
  let a := a.insn "mov rsi, r15"
  let a := a.insn "mov rdx, [rsp+0x5030]"
  let a := a.insn "mov rdi, r12"
  let a := a.call "x_out_str"
  let a := outStr a "r12" "\",\"author\":\""
  let a := a.insn "mov rsi, [rip+g_uname_ptr]"
  let a := a.insn "mov rdx, [rip+g_uname_len]"
  let a := a.insn "mov rdi, r12"
  let a := a.call "x_out_str"
  let a := outStr a "r12" "\",\"like_count\":0}}"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_reset"
  let a := a.insn "mov eax, 201"
  let a := a.insn "add rsp, 0x5040"
  let a := a.insn "jmp .Ldone"
  -- error paths (each pops the frame first)
  let a := a.label ".Lcreate_malformed"
  let a := a.insn "add rsp, 0x5040"
  let a := outErrorBody a "r12" "malformed JSON body"
  let a := a.insn "mov eax, 400"
  let a := a.insn "jmp .Ldone"
  let a := a.label ".Lcreate_required"
  let a := a.insn "add rsp, 0x5040"
  let a := outErrorBody a "r12" "body is required"
  let a := a.insn "mov eax, 400"
  let a := a.insn "jmp .Ldone"
  let a := a.label ".Lcreate_toolong"
  let a := a.insn "add rsp, 0x5040"
  let a := outErrorBody a "r12" "body must be at most 500 characters"
  let a := a.insn "mov eax, 400"
  let a := a.insn "jmp .Ldone"
  let a := a.label ".Lcreate_500x"
  let a := a.insn "add rsp, 0x5040"
  let a := a.insn "mov rdi, r12"
  let a := a.call "x_fail"
  let a := a.insn "jmp .Ldone"
  a

/-- POST /posts/:id/like after auth OK and valid id (rax = id). -/
def emitLikePost (a : Asm) : Asm :=
  let a := a.label ".Llike_body"
  let a := a.insn "mov r14, rax"               -- the post id
  -- existence
  let sqlE := "SELECT 1 FROM posts WHERE id = ?"
  let (a, lSqlE) := a.poolStr sqlE
  let a := a.insn (s!"lea rdi, [rip+{lSqlE}]")
  let a := a.insn (s!"mov esi, {String.length sqlE}")
  let a := a.call "x_db_prepare"
  let a := a.insn "test rax, rax"
  let a := a.insn "jz .Lerr500"
  let a := a.insn "mov r13, rax"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 1"
  let a := a.insn "mov rdx, r14"
  let a := a.call "x_db_bind_int"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_step"
  let a := a.insn "cmp eax, 1"
  let a := a.insn "jne .Llike_notfound"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_reset"
  -- insert (idempotent)
  let sqlL := "INSERT INTO likes (user_id, post_id) VALUES (?, ?) ON CONFLICT (user_id, post_id) DO NOTHING"
  let (a, lSqlL) := a.poolStr sqlL
  let a := a.insn (s!"lea rdi, [rip+{lSqlL}]")
  let a := a.insn (s!"mov esi, {String.length sqlL}")
  let a := a.call "x_db_prepare"
  let a := a.insn "test rax, rax"
  let a := a.insn "jz .Lerr500"
  let a := a.insn "mov r13, rax"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 1"
  let a := a.insn "mov rdx, [rip+g_uid]"
  let a := a.call "x_db_bind_int"
  let a := a.insn "mov rdi, r13"
  let a := a.insn "mov esi, 2"
  let a := a.insn "mov rdx, r14"
  let a := a.call "x_db_bind_int"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_step"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_reset"
  let a := a.call "x_db_changes"
  let a := a.insn "xor r15d, r15d"
  let a := a.insn "cmp rax, 1"
  let a := a.insn "setne r15b"                 -- r15 = 1 -> already liked
  -- body {"liked":true,"already_liked":B,"post_id":N}
  let a := outStr a "r12" "{\"liked\":true,\"already_liked\":"
  let (a, lT) := a.poolStr "true"
  let (a, lF) := a.poolStr "false"
  let a := a.insn "test r15d, r15d"
  let a := a.insn "jz .Llike_first"
  let a := outStr a "r12" "true"
  let a := a.insn "jmp .Llike_postid"
  let a := a.label ".Llike_first"
  let a := outStr a "r12" "false"
  let a := a.label ".Llike_postid"
  let a := outStr a "r12" ",\"post_id\":"
  let a := a.insn "mov rdi, r12"
  let a := a.insn "mov rsi, r14"
  let a := a.call "x_out_int"
  let a := a.insn "mov rdi, r12"
  let a := a.insn "mov esi, 125"              -- '}'
  let a := a.call "x_out_byte"
  let a := a.insn "mov eax, 201"
  let a := a.insn "test r15d, r15d"
  let a := a.insn "jz .Llike_st"
  let a := a.insn "mov eax, 200"
  let a := a.label ".Llike_st"
  let a := a.insn "jmp .Ldone"
  let a := a.label ".Llike_notfound"
  let a := a.insn "mov rdi, r13"
  let a := a.call "x_db_reset"
  let a := outErrorBody a "r12" "post not found"
  let a := a.insn "mov eax, 404"
  let a := a.insn "jmp .Ldone"
  a

